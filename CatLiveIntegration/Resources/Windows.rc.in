101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../JarasLive/Installer/Assets/CatLive.ico"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS 0x40004
 FILETYPE 1
 BEGIN
   BLOCK "StringFileInfo"
   BEGIN
     BLOCK "040904B0"
     BEGIN
       VALUE "FileDescription", "CatLive Integration\0"
       VALUE "FileVersion", "@INTEGRATION_RELEASE_VERSION@\0"
       VALUE "ProductName", "CatLive Integration\0"
       VALUE "ProductVersion", "@INTEGRATION_RELEASE_VERSION@\0"
     END
   END
   BLOCK "VarFileInfo"
   BEGIN
     VALUE "Translation", 0x0409, 1200
   END
 END
