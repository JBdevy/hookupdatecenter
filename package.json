{
  "name": "hook-center",
  "version": "2.7.0",
  "description": "Hook Center - atualizador, licença e conexão via app do VS Hook",
  "main": "src/main.js",
  "author": "Hook Developer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg zip --universal --publish never",
    "build:mac:legacy": "electron-builder --config electron-builder.legacy.json --mac dmg zip --x64 --publish never",
    "build:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --universal --publish never"
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "@electron/notarize": "^2.5.0"
  },
  "build": {
    "appId": "com.hookdeveloper.hookcenter",
    "productName": "Hook Center",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "qr-app/**/*",
      "assets/**/*",
      "package.json",
      "installer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hook-Center-${version}-Windows.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/uninstaller.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "11.0",
      "category": "public.app-category.utilities",
      "artifactName": "Hook-Center-${version}-macOS.${ext}",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "forceCodeSigning": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "icon": "assets/icon.png",
    "afterSign": "build/notarize.js"
  }
}
