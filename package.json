{
  "name": "hook-center",
  "hookCenterVariant": "standard",
  "version": "1.0.1",
  "description": "Hook Center - atualizador, licença e conexão via app do VS Hook",
  "main": "src/main.js",
  "author": "Hook Developer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:create-project": "node tests/create-project.test.js",
    "test:add-project": "node tests/add-project.test.js",
    "test:hook-marker": "node tests/hook-marker.test.js && node tests/resolume-add-songs.test.js && node tests/resolume-reset.test.js && node tests/resolume-deck-add.test.js && node tests/resolume-mutation-retry.test.js",
    "test:hook-rename": "node tests/hook-rename-removal.test.js && node tests/hook-rename-ui.test.js",
    "test:bridge-network": "node tests/bridge-network.test.js",
    "test:artifact-download": "node tests/artifact-download.test.js",
    "build": "node scripts/prepare-windows-midi.js --if-windows && node scripts/prepare-ffmpeg-runtime.js --current && electron-builder --publish never",
    "build:win": "node scripts/prepare-windows-midi.js && node scripts/prepare-ffmpeg-runtime.js --windows && electron-builder --win nsis --publish never",
    "build:mac": "chmod +x build/pkg-scripts/postinstall && electron-builder --mac pkg --universal --publish never",
    "build:mac:unsigned": "chmod +x build/pkg-scripts/postinstall && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac pkg --universal --publish never --config.mac.forceCodeSigning=false"
  },
  "dependencies": {
    "electron-store": "8.2.0",
    "emoji-picker-element": "1.29.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "electron": "26.6.10",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.hookdeveloper.hookcenter",
    "productName": "Hook Center",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "qr-app/**/*",
      "assets/**/*",
      "package.json",
      "installer/**/*"
    ],
    "extraResources": [
      {
        "from": "build/vshook-companion",
        "to": "vshook-companion",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "themes",
        "to": "vshook-themes",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hook-Center-${version}-Windows.${ext}",
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "vendor/windows-midi-services/Windows-MIDI-Services-Runtime-and-Tools-x64.exe",
          "to": "windows-midi-services/Windows-MIDI-Services-Runtime-and-Tools-x64.exe"
        },
        {
          "from": "vendor/ffmpeg/ffmpeg-8.1.2-win64-lgpl-shared.zip",
          "to": "ffmpeg-runtime/ffmpeg-8.1.2-win64-lgpl-shared.zip"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/uninstaller.nsh"
    },
    "mac": {
      "target": [
        "pkg"
      ],
      "minimumSystemVersion": "10.13.0",
      "category": "public.app-category.utilities",
      "artifactName": "Hook-Center-${version}-macOS.${ext}",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "forceCodeSigning": true,
      "x64ArchFiles": "Contents/Resources/vshook-companion/**",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "A Hook Center usa o microfone somente quando você grava uma mensagem de voz no Chat Hook."
      },
      "notarize": false
    },
    "pkg": {
      "scripts": "pkg-scripts",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false,
      "mustClose": [
        "com.hookdeveloper.hookcenter"
      ]
    },
    "icon": "assets/icon.png"
  }
}
