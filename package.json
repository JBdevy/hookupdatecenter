{
  "name": "hook-center",
  "version": "1.8.0",
  "description": "Hook Center - atualizador, licença e conexão via app do VS Hook",
  "main": "src/main.js",
  "author": "Hook Developer",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg pkg zip --universal --publish never"
  },
  "dependencies": {
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.hookdeveloper.hookcenter",
    "productName": "Hook Center",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "installer/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hook-Center-${version}-Windows.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/uninstaller.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "minimumSystemVersion": "11.0",
      "category": "public.app-category.utilities",
      "artifactName": "Hook-Center-${version}-macOS.${ext}",
      "icon": "assets/icon.icns"
    },
    "icon": "assets/icon.png"
  }
}
