<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Encryption is provided by Apple's CryptoKit and system networking. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>O CatLive usa a entrada de áudio para gravar e monitorar as pistas no modo Nativo. / CatLive uses the audio input to record and monitor tracks in Native mode.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>O CatLive encontra computadores próximos para controlar seu projeto pelo Remote. / CatLive finds nearby computers to control your project through Remote.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_jaras-live._tcp</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
