file(MAKE_DIRECTORY "${OUTPUT}")
execute_process(COMMAND "${REFERENCE}" OUTPUT_FILE "${OUTPUT}/reference.pcm" RESULT_VARIABLE referenceResult)
execute_process(COMMAND "${BATCHED}" OUTPUT_FILE "${OUTPUT}/batched.pcm" RESULT_VARIABLE batchedResult)
if(NOT referenceResult EQUAL 0 OR NOT batchedResult EQUAL 0)
    message(FATAL_ERROR "Signalsmith PCM render failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${OUTPUT}/reference.pcm" "${OUTPUT}/batched.pcm" RESULT_VARIABLE difference)
if(NOT difference EQUAL 0)
    message(FATAL_ERROR "Batched output changed the reference PCM")
endif()
