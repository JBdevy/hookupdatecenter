{
  "name": "vs-hook-mobile",
  "version": "1.0.2",
  "private": true,
  "description": "VS Hook Mobile - Android/iOS",
  "scripts": {
    "test:director-search": "node scripts/test-director-search.js",
    "test:director-touch-feedback": "node scripts/test-director-touch-feedback.js",
    "test:director-bar-clock": "node scripts/test-director-bar-clock.js",
    "test:director-individual-time": "node scripts/test-director-individual-time.js",
    "test:director-performance": "node scripts/test-director-performance.js",
    "build": "node scripts/check-safe-area.js && node scripts/build-static.js",
    "start": "vite --host 0.0.0.0",
    "sync:android": "npm run build && npx cap sync android",
    "sync:ios": "npm run build && npx cap sync ios",
    "build:android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:android:aab": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.2.0",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/keyboard": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "vite": "^5.4.0"
  }
}
